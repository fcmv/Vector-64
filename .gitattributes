# Normalize line endings: store text as LF in the repo, check out native.
# Shell scripts stay LF everywhere so they run on POSIX hosts.
* text=auto eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Preserve benchmark evidence byte for byte for its published hashes.
benchmarks/**/*.txt -text -whitespace
benchmarks/**/results.json -text
benchmarks/**/summary.md -text -whitespace

*.nnue binary
*.npz binary
*.pt binary
*.bin binary
